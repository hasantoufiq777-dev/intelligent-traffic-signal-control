# Production settings for the gateway. Copy to /etc/itsc/gateway.env (read by deploy/itsc-gateway.service),
# fill in the blanks, and make it readable only by root and the service user:
#   sudo install -m 640 -o root -g itsc deploy/gateway.env.production.example /etc/itsc/gateway.env
# No real secrets belong in this file in the repository.

NODE_ENV=production
# Only nginx talks to the gateway; do not expose this port to the internet
HOST=127.0.0.1
PORT=4000

# ---- simulation -----------------------------------------------------------------
# Python virtual environment with sim/requirements.txt installed
PYTHON_BIN=/srv/itsc/.venv/bin/python
SIM_ENTRY=sim/main.py
USE_MOCK=false
# SUMO installation (Ubuntu package: /usr/share/sumo); passed to the simulation process
SUMO_HOME=/usr/share/sumo
# Loop the playlist so visitors always see a run
LIVE_LOOP=true
PLAYLIST_PATH=/srv/itsc/server/playlist.json
# Wall-clock seconds per simulated second
SIM_STEP_DELAY=1.0
SIM_GUI=false

# ---- accounts and security -------------------------------------------------------
# First administrator, created at the first start when none exists. Use 10+ characters, start once,
# sign in, then DELETE the ADMIN_PASSWORD line and restart. Alternative: sudo -u itsc npm run create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_REGISTRATION=false
SESSION_TTL_HOURS=12
SESSIONS_PER_USER=10
# Session cookies only over HTTPS (the default when NODE_ENV=production; stated here for clarity)
COOKIE_SECURE=true
# One reverse proxy (nginx) in front: client addresses come from X-Forwarded-For
TRUST_PROXY=1
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
RESET_LINK_MINUTES=60
RATE_LIMIT_PER_MIN=600
AUTH_RATE_LIMIT=30
# Empty: the dashboard is served from the same origin as the API (recommended). Only list extra
# origins (comma separated, with https://) if another site must call the API with cookies.
CORS_ORIGIN=

# ---- limits and retention ------------------------------------------------------------
MAX_CONNECTIONS=1000
MAX_SIM_FAILURES=3
AUDIT_RETENTION_DAYS=180
SAMPLE_RETENTION_DAYS=14

# ---- storage and logs ---------------------------------------------------------------
DB_PATH=/var/lib/itsc/gateway.db
# Logs go to stderr (journald with the systemd unit): journalctl -u itsc-gateway
LOG_LEVEL=info

# ---- one-driver mode ------------------------------------------------------------------
DRIVER_MODE=true
DRIVER_IDLE_MS=120000
DRIVER_MAX_MS=600000
DRIVER_RESUME_MS=15000
DRIVER_CMDS_PER_S=2
DRIVER_STEP_DELAY=0.5
