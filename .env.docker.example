# Settings for docker compose. Copy to .env (git ignores it) and fill in the blanks:
#   cp .env.docker.example .env
# No real secrets belong in this file.

# First administrator, created at the first start when none exists (password: 10+ characters).
# After the first sign-in, remove ADMIN_PASSWORD and start again (docker compose up -d).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- this computer (docker-compose.yml) -------------------------------------------------
# Port that opens the dashboard: http://localhost:4100 (4000 stays free for npm run dev)
HOST_PORT=4100
# Plain http on localhost: false
COOKIE_SECURE=false
TRUST_PROXY=0

# ---- server (docker-compose.prod.yml) ----------------------------------------------------
# Your domain, or the server's IP with dashes + .sslip.io (e.g. 20-55-1-2.sslip.io)
DOMAIN=

# ---- both ----------------------------------------------------------------------------------
# Wall-clock seconds per simulated second (1.0 = real time)
SIM_STEP_DELAY=1.0
LOG_LEVEL=info
