# better-sqlite3 ships prebuilt binaries for Windows, Linux and macOS (prebuilds/), and its
# package.json says no native build is needed ("gypfile": false). When installing from
# package-lock.json, npm still runs "node-gyp rebuild" for it, which fails without a C++ compiler.
# No server dependency needs an install script (fsevents is macOS-only and optional), so skip them.
ignore-scripts=true
