# Copy to server/.env and adjust.
PORT=4000
HOST=0.0.0.0

# Python interpreter that has the sim requirements (e.g. ../.venv/Scripts/python.exe on Windows,
# ../.venv/bin/python on Linux). SUMO_HOME is passed through to the child process.
PYTHON_BIN=python
SIM_ENTRY=sim/main.py
# true = stream the fake simulation (sim/mock_sim.py); no SUMO needed
USE_MOCK=false

# ---- Accounts and security ---------------------------------------------------
# production = Secure cookies (HTTPS only) and HSTS
NODE_ENV=development
# First administrator, created at start-up when no administrator exists. Use a password of at
# least 10 characters, then remove ADMIN_PASSWORD from this file (or run: npm run create-admin).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Let visitors create their own (viewer) account. Administrators can change this at run time.
ALLOW_REGISTRATION=false
SESSION_TTL_HOURS=12
# Number of reverse proxies in front of the gateway (nginx or a tunnel: 1), so client addresses are right
TRUST_PROXY=0
# Sign-in: failures before an account is locked, and for how long
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
# Requests per address: API per minute, and sign-in/registration/reset attempts per 15 minutes
RATE_LIMIT_PER_MIN=600
AUTH_RATE_LIMIT=30
# Hard limit on concurrent live connections; more are refused with a clear message
MAX_CONNECTIONS=1000
# Failed runs in a row after which the playlist stops retrying
MAX_SIM_FAILURES=3

# true = loop the playlist forever (playlist.json); a crashed run is retried with the next entry after 5 s
LIVE_LOOP=true
PLAYLIST_PATH=./playlist.json

DB_PATH=./data/gateway.db
# Defaults to ../results/summary.json
# SUMMARY_PATH=
# Extra browser origins allowed to use the API with cookies (comma separated). Empty = same origin only.
CORS_ORIGIN=

# Wall-clock seconds per simulated second for the live run (0 = as fast as possible)
SIM_STEP_DELAY=0.25
# SIM_MAX_STEPS=600
# true = also show the live run in the SUMO-GUI window on this computer
SIM_GUI=false
MOCK_STEP_DELAY=0.5
MOCK_MAX_STEPS=300

# debug | info | warn | error | silent
LOG_LEVEL=info

# One-driver mode: one viewer at a time drives a car in the live run (the admin can switch it off)
DRIVER_MODE=true
DRIVER_IDLE_MS=120000
DRIVER_MAX_MS=600000
DRIVER_RESUME_MS=15000
DRIVER_CMDS_PER_S=2
DRIVER_STEP_DELAY=0.5
