# Copy to server/.env and adjust.
PORT=4000
HOST=0.0.0.0

# Python interpreter that has the sim requirements (e.g. ../.venv/Scripts/python.exe on Windows,
# ../.venv/bin/python on Linux). SUMO_HOME is passed through to the child process.
PYTHON_BIN=python
SIM_ENTRY=sim/main.py
# true = stream the fake simulation (sim/mock_sim.py); no SUMO needed
USE_MOCK=false

# Required for POST /api/live/start and /api/live/stop (header X-Admin-Token). Empty = admin disabled.
ADMIN_TOKEN=change-me

# true = loop the playlist forever (playlist.json); a crashed run is retried with the next entry after 5 s
LIVE_LOOP=true
PLAYLIST_PATH=./playlist.json

DB_PATH=./data/gateway.db
# Defaults to ../results/summary.json
# SUMMARY_PATH=
CORS_ORIGIN=*

# Wall-clock seconds per simulated second for the live run (0 = as fast as possible)
SIM_STEP_DELAY=0.25
# SIM_MAX_STEPS=600
# true = also show the live run in the SUMO-GUI window on this computer
SIM_GUI=false
MOCK_STEP_DELAY=0.5
MOCK_MAX_STEPS=300

# debug | info | warn | error | silent
LOG_LEVEL=info
