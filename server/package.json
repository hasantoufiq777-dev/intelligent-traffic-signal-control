{
  "name": "itsc-gateway",
  "version": "1.0.0",
  "description": "Node.js gateway for the VANET traffic signal simulation: shared live broadcast, REST API, SQLite persistence",
  "type": "module",
  "main": "src/index.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --watch src src/index.js",
    "dev:mock": "cross-env USE_MOCK=true nodemon --watch src src/index.js",
    "test": "vitest run",
    "loadtest": "node loadtest/viewers.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
